  "manifest": "--manifest: the immutable node manifest (payload_sha256 paths/sha256/rows, parents, core_hash). Payloads are resolved from it; nothing is globbed for reading, and rows are scanned one day-partition at a time.",
  "no_legacy_panel": "no outcome panel, panel.parquet, basket_atlas_panel or outcome/censor namespace is imported, read or derived anywhere in this inspection",
  "observation_contract": "factory/artifacts/basket/phase2/ATLAS/TAPE/OBSERVATION/v0/contract.json (allowed_blind_summaries, identity.expected_panel_census, day_guard, tier_support_matrix)",
  "schema": "factory/artifacts/basket/phase2/ATLAS/TAPE/OBSERVATION/v0/schema.json (declared fields, dtypes, namespaces, coordinate_only / prospective_allowed / retrospective_only, supportable_by_tier)"
 },
