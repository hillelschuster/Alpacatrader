   "censor",
   "quality"
  ],
  "numeric_dtypes": [
   "int32",
   "int64",
   "float32",
   "float64"
  ],
  "numeric_rules": "a numeric-summary column must be prospective_allowed, not retrospective_only, not coordinate_only, not provenance/censor/quality; keys, coordinates and masks follow the same namespace and flag rules. Hash, provenance, censor and whole-day quality columns are excluded from every numeric summary.",
  "path_rules": "payload paths must be relative, traversal-free, resolve inside --root, and carry a guard_day-clean day inside the manifest day set",
  "physical_deny_audit": "each scanned payload's physical schema is checked against the causal registry deny vocabulary; a denied column name refuses the run before any row is read",
  "refusals": {
   "contract": "illegal allowlist / hash mismatch / denied physical column / sealed day (no report is written)",
   "integrity": "declared payload absent, row-count or sha256 mismatch, parent drift (report is written with status REFUSED and exit code 3)"
  }
 },
