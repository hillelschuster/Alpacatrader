 "purpose": "Freeze the positive per-column allowlist, strata and statistic plan used by factory/scripts/basket_tape_atlas_inspect.py to produce the outcome-blind corpus report of PLAN-TAPE-ATLAS.md section 2 (Stage 0C). It declares what may be READ and COUNTED; it freezes no representation, metric, weight, threshold, gate, distance or outcome, and it may not be read as a finding.",
 "rank_change": [
  {
   "column": "rank_known",
   "key": "ticker",
   "layer": "race_minute_full",
   "note": "consecutive-minute rank change inside a name; population/staleness/change distributions only, no outcome",
   "time": "t"
  }
 ],
 "rarity": {
  "note": "rare/low-density candidate preservation counts: how many OBSERVED rows carry raw magnitude or raw activity at or above the frozen thresholds, by layer and block. No future tail label (tail_class_*, final_high_flag, remaining_run, cost_of_waiting, bars_to_*) is read or derived: these are density facts about the observed tape, not outcome strata.",
  "rules": [
   {
    "column": "gain",
    "kind": "magnitude",
    "layer": "race_minute_full",
    "thresholds": [
     0.25,
     0.5,
     1.0,
     2.0,
     5.0,
     10.0
    ]
   },
   {
    "column": "px",
    "kind": "magnitude",
    "layer": "race_minute_full",
    "thresholds": [
     1,
     5,
     10,
     50,
     100
    ]
   },
   {
    "column": "n_eligible",
    "kind": "activity",
    "layer": "race_minute_full",
    "thresholds": [
     10,
     50,
     100,
     200
    ]
   },
   {
    "column": "px_T",
    "kind": "magnitude",
    "layer": "race_checkpoint_full",
    "thresholds": [
     1,
     5,
     10,
     50,
     100
    ]
   },
   {
    "column": "px",
    "kind": "magnitude",
    "layer": "race_candidate_net",
    "thresholds": [
     1,
     5,
     10,
     50,
     100
    ]
   },
   {
    "column": "bar_ret_from_open",
    "kind": "magnitude",
    "layer": "selected_path_grid",
    "thresholds": [
     0.25,
     0.5,
     1.0,
     2.0,
     5.0
    ]
   },
   {
    "column": "bar_close",
    "kind": "magnitude",
    "layer": "selected_path_grid",
    "thresholds": [
     1,
     5,
     10,
     50,
     100
    ]
   },
   {
    "column": "bar_volume",
    "kind": "activity",
    "layer": "selected_path_grid",
    "thresholds": [
     10000,
     100000,
     1000000
    ]
   },
   {
    "column": "n_prints",
    "kind": "activity",
    "layer": "selected_path_grid",
    "thresholds": [
     10,
     100,
     1000
    ]
   },
   {
    "column": "price",
    "kind": "magnitude",
    "layer": "selected_path_prints",
    "thresholds": [
     1,
     5,
     10,
     50,
     100
    ]
   },
   {
    "column": "size",
    "kind": "activity",
    "layer": "selected_path_prints",
    "thresholds": [
     1000,
     10000,
     100000
    ]
   },
   {
    "column": "notional",
    "kind": "activity",
    "layer": "selected_path_prints",
    "thresholds": [
     100000,
     1000000,
     10000000
    ]
   }
  ]
 },
 "read_inputs": {
  "causal_registry": "factory/artifacts/basket/phase2/ATLAS/TAPE/OBSERVATION/v0/causal_registry.json (denied_prefixes, denied_exact_columns, blocked_families; default deny)",
  "contract_lock": "factory/artifacts/basket/phase2/ATLAS/TAPE/OBSERVATION/v0/contract_lock.json (expected schema/contract/registry hashes)",
