  "block": "day <= 2023-12-31 -> block1, else block2 (contract.json day_guard.block_gap_rule)",
  "feed_era": "day_registry.feed_era for that day (day map sourced from the day_registry payload)",
  "month": "day[:7]",
  "note": "reported for every layer as by_strata; a physical block/month/feed_era coordinate is reported under by_coordinate and not duplicated"
 },
 "enforce": {
  "default_deny": true,
  "deny_namespace_all": [
