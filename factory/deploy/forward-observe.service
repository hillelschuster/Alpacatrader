[Unit]
Description=Forward evidence observer (order-free)
Documentation=file:///opt/alpacatrader/factory/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/alpacatrader
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 factory/scripts/forward_observe.py --live
Restart=always
RestartSec=5
StandardOutput=append:/opt/alpacatrader/logs/forward_observe.log
StandardError=append:/opt/alpacatrader/logs/forward_observe.log

[Install]
WantedBy=multi-user.target
